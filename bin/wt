#!/usr/bin/env bash
#
# wt — git worktree + tmux session manager for Rails apps, with agent-mail
#
# Usage:
#   wt <branch>                Create/attach a worktree session for <branch>
#   wt done [branch] [--force] Kill the session and remove the worktree
#   wt init <rails|node|django> Stamp a committable .wt-config into this repo
#
# Layout (driver = first roster entry, workers stacked below):
#   ┌──────────────┬──────────────┐
#   │    claude    │  empty shell │
#   ├──────────────┤              │
#   │      pi      ├──────────────┤
#   ├──────────────┤   bin/dev    │
#   │     grok     │              │
#   └──────────────┴──────────────┘
#
# Roster: agents.conf in the agent-env repo, overridable per-repo with a
# .wt-agents file in the main checkout (format: name | command | notes).
# Overrides (env): WT_<NAME>_CMD, WT_DEV_CMD, WT_SETUP_CMD, WT_MAIL_ROOT
#
set -euo pipefail

die() { echo "wt: $*" >&2; exit 1; }

command -v tmux >/dev/null || die "tmux is not installed"
command -v git >/dev/null || die "git is not installed"

MAIL_ROOT="${WT_MAIL_ROOT:-$HOME/.agents-mail}"

# Exported env always beats .wt-config; remember what the caller set.
env_dev_cmd="${WT_DEV_CMD:-}"
env_setup_cmd="${WT_SETUP_CMD:-}"
env_layout="${WT_LAYOUT:-}"

# Resolve the agent-env repo dir (wt is symlinked into ~/.local/bin)
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do script_path="$(readlink "$script_path")"; done
AGENT_ENV_DIR="$(cd "$(dirname "$script_path")/.." && pwd)"

# --- Agent roster -----------------------------------------------------------

AGENT_NAMES=(); AGENT_CMDS=(); AGENT_NOTES=()
BENCH_NAMES=(); BENCH_NOTES=()
load_roster() {
  local conf line name cmd notes mode upper override
  if [ -f "$main_checkout/.wt-agents" ]; then
    conf="$main_checkout/.wt-agents"
  else
    conf="$AGENT_ENV_DIR/agents.conf"
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    name="$(echo "$line" | cut -d'|' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    cmd="$(echo "$line" | cut -d'|' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    notes="$(echo "$line" | cut -d'|' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    mode="$(echo "$line" | cut -d'|' -f4 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -n "$name" ] && [ -n "$cmd" ] || continue
    if [ "$mode" = "demand" ]; then
      BENCH_NAMES+=("$name"); BENCH_NOTES+=("$notes")
      continue
    fi
    upper="$(echo "$name" | tr '[:lower:]-' '[:upper:]_')"
    override="$(eval echo "\${WT_${upper}_CMD:-}")"
    [ -n "$override" ] && cmd="$override"
    command -v "${cmd%% *}" >/dev/null || echo "wt: warning — '$name' command not found: ${cmd%% *} (pane will error until installed)" >&2
    AGENT_NAMES+=("$name"); AGENT_CMDS+=("$cmd"); AGENT_NOTES+=("$notes")
  done < "$conf"
  [ "${#AGENT_NAMES[@]}" -ge 1 ] || die "no agents found in roster: $conf"
}

# --- Repo context -----------------------------------------------------------

# Works from the main checkout or any worktree of it.
git rev-parse --git-dir >/dev/null 2>&1 || die "run this from inside a git repo"

common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
main_checkout="$(dirname "$common_dir")"
repo_name="$(basename "$main_checkout")"
worktrees_root="$(dirname "$main_checkout")/${repo_name}-worktrees"

# Per-repo stack config: a shell fragment in the main checkout that may set
# WT_DEV_CMD, WT_SETUP_CMD, WT_COPY_PATTERNS, WT_PORT_BASE, WT_<NAME>_CMD.
# Defaults below are Rails; a Node/Django/Rust repo overrides here.
[ -f "$main_checkout/.wt-config" ] && . "$main_checkout/.wt-config"

DEV_CMD="${env_dev_cmd:-${WT_DEV_CMD:-bin/dev}}"       # runs with PORT set
SETUP_CMD="${env_setup_cmd:-${WT_SETUP_CMD:-bin/setup}}" # once, fresh worktrees
COPY_PATTERNS="${WT_COPY_PATTERNS:-.env .env.* config/master.key config/credentials/*.key}"
PORT_BASE="${WT_PORT_BASE:-3000}"
LAYOUT="${env_layout:-${WT_LAYOUT:-panes}}"   # panes (grid) | windows (one per agent)

session_name() {
  # tmux session names may not contain '.' or ':'
  echo "${repo_name}--$1" | tr './:' '---'
}

default_branch() {
  local ref
  if ref="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)"; then
    echo "${ref#refs/remotes/origin/}"
    return
  fi
  for b in main master; do
    git show-ref --verify --quiet "refs/remotes/origin/$b" && { echo "$b"; return; }
    git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }
  done
  die "could not determine the default branch"
}

port_in_use() {
  if command -v lsof >/dev/null; then
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  elif command -v ss >/dev/null; then
    ss -ltn "sport = :$1" 2>/dev/null | grep -q LISTEN
  else
    nc -z 127.0.0.1 "$1" >/dev/null 2>&1
  fi
}

find_free_port() {
  local port="$PORT_BASE" limit=$((PORT_BASE + 100))
  while port_in_use "$port"; do
    port=$((port + 1))
    [ "$port" -gt "$limit" ] && die "no free port found between $PORT_BASE and $limit"
  done
  echo "$port"
}

# --- Mailbox / watcher ------------------------------------------------------

setup_mailbox() {
  local session="$1" wt_path="$2"
  local mail_dir="$MAIL_ROOT/$session" name i
  for name in "${AGENT_NAMES[@]}" user; do
    mkdir -p "$mail_dir/inbox-$name/done"
  done
  mkdir -p "$mail_dir/logs" "$mail_dir/grants"
  # Roster file: the driver reads this to route subtasks to the right worker.
  : > "$mail_dir/roster"
  for i in "${!AGENT_NAMES[@]}"; do
    echo "${AGENT_NAMES[$i]} — ${AGENT_NOTES[$i]:-no notes}" >> "$mail_dir/roster"
  done
  if [ "${#BENCH_NAMES[@]}" -gt 0 ]; then
    for i in "${!BENCH_NAMES[@]}"; do
      echo "${BENCH_NAMES[$i]} — ${BENCH_NOTES[$i]:-no notes} (not running; start with: agent-mail spawn ${BENCH_NAMES[$i]})" >> "$mail_dir/roster"
    done
  fi
  # NOTE: named .agent-mail, not .agents — pi owns .agents/ (its skills dir).
  if [ -e "$wt_path/.agent-mail" ] && [ ! -L "$wt_path/.agent-mail" ]; then
    die ".agent-mail exists in the worktree and is not a symlink — move it aside"
  fi
  ln -sfn "$mail_dir" "$wt_path/.agent-mail"
  # Worker protocol for AGENTS.md-reading tools (grok, pi), only if the repo
  # doesn't track its own AGENTS.md.
  if [ ! -e "$wt_path/AGENTS.md" ]; then
    cp "$AGENT_ENV_DIR/templates/worker-agents-md.md" "$wt_path/AGENTS.md"
  fi
  # Push guard: blocks force-push/default-branch pushes from any worktree.
  local hook="$common_dir/hooks/pre-push"
  mkdir -p "$common_dir/hooks"
  if [ -f "$hook" ] && ! grep -q "agent-env push guard" "$hook"; then
    echo "wt: existing pre-push hook found — push guard NOT installed (merge $AGENT_ENV_DIR/hooks/pre-push-guard manually)" >&2
  else
    cp "$AGENT_ENV_DIR/hooks/pre-push-guard" "$hook" && chmod +x "$hook"
  fi
  # Hide agent files from git status across all worktrees of this repo.
  local exclude="$common_dir/info/exclude"
  mkdir -p "$(dirname "$exclude")"
  for pat in .agent-mail .agents AGENTS.md .wt-agents .wt-config .wt-guard-patterns; do
    grep -qxF "$pat" "$exclude" 2>/dev/null || echo "$pat" >> "$exclude"
  done
  # Per-repo credential-guard extensions (scope:regex per line) for stacks
  # with their own secret files — the hook reads this from the mailbox.
  if [ -f "$main_checkout/.wt-guard-patterns" ]; then
    cp "$main_checkout/.wt-guard-patterns" "$mail_dir/guard-patterns"
  fi
  echo "$mail_dir"
}

ensure_watcher() {
  local session="$1" mail_dir="$2"
  local pid_file="$mail_dir/watch.pid"
  if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    return
  fi
  nohup agent-mail-watch "$session" "$mail_dir" >/dev/null 2>&1 &
  echo $! > "$pid_file"
}

# Weekly self-update check for agent tooling, piggybacked on normal wt usage.
maybe_update_tools() {
  local stamp="$MAIL_ROOT/.tools-update-stamp"
  if [ -f "$stamp" ]; then
    local mtime
    # GNU stat first (-c); BSD/macOS fallback (-f). Order matters: GNU's -f
    # "succeeds" with filesystem info and would poison the arithmetic below.
    mtime="$(stat -c %Y "$stamp" 2>/dev/null || stat -f %m "$stamp" 2>/dev/null)" || return 0
    case "$mtime" in *[!0-9]*) return 0 ;; esac
    [ $(( $(date +%s) - mtime )) -lt 604800 ] && return 0
  fi
  mkdir -p "$MAIL_ROOT"
  touch "$stamp"
  local updating=""
  if command -v qmd >/dev/null && command -v npm >/dev/null; then
    (npm update -g @tobilu/qmd >/dev/null 2>&1 &)
    updating="qmd"
  fi
  if command -v pi >/dev/null; then
    (pi update >/dev/null 2>&1 </dev/null &)
    updating="${updating:+$updating, }pi"
  fi
  [ -n "$updating" ] && echo "weekly update check running in background: $updating"
}

stop_watcher() {
  local pid_file="$MAIL_ROOT/$1/watch.pid"
  if [ -f "$pid_file" ]; then
    kill "$(cat "$pid_file")" 2>/dev/null || true
    rm -f "$pid_file"
  fi
}

# --- wt done ----------------------------------------------------------------

wt_done() {
  local branch="" force=""
  for arg in "$@"; do
    case "$arg" in
      --force) force="--force" ;;
      *) branch="$arg" ;;
    esac
  done

  if [ -z "$branch" ]; then
    # Infer from the current worktree, but never tear down the main checkout.
    local top
    top="$(git rev-parse --show-toplevel)"
    [ "$top" = "$main_checkout" ] && die "usage: wt done <branch> (or run from inside a worktree)"
    branch="$(git rev-parse --abbrev-ref HEAD)"
  fi

  local wt_path="$worktrees_root/$branch"
  local session; session="$(session_name "$branch")"

  cd "$main_checkout"

  if [ -d "$wt_path" ]; then
    if ! git worktree remove ${force:+"$force"} "$wt_path" 2>/dev/null; then
      die "worktree has uncommitted changes — commit them or rerun with: wt done $branch --force"
    fi
    git worktree prune
    echo "removed worktree $wt_path (branch '$branch' kept)"
  else
    echo "no worktree at $wt_path, skipping"
  fi

  stop_watcher "$session"

  if tmux has-session -t "=$session" 2>/dev/null; then
    echo "killing tmux session $session"
    tmux kill-session -t "=$session"
  fi
  echo "mail history kept at $MAIL_ROOT/$session"

  if command -v qmd >/dev/null; then
    (qmd update >/dev/null 2>&1 &)
    echo "qmd re-indexing mail history in background"
  fi
}

# --- wt <branch> ------------------------------------------------------------

wt_start() {
  local branch="$1"
  local session; session="$(session_name "$branch")"
  local wt_path="$worktrees_root/$branch"

  load_roster
  maybe_update_tools

  # Already running? Make sure the doorbell is alive, then go there.
  if tmux has-session -t "=$session" 2>/dev/null; then
    if [ -f "$MAIL_ROOT/$session/panes" ]; then
      ensure_watcher "$session" "$MAIL_ROOT/$session"
    fi
    exec_attach "$session"
  fi

  local fresh=""
  if [ ! -d "$wt_path" ]; then
    fresh=1
    mkdir -p "$worktrees_root"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      echo "branch '$branch' exists locally — creating worktree"
      git worktree add "$wt_path" "$branch"
    elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      echo "branch '$branch' exists on origin — creating tracking worktree"
      git worktree add "$wt_path" -b "$branch" "origin/$branch"
    else
      local base; base="$(default_branch)"
      echo "creating branch '$branch' off '$base'"
      git fetch origin "$base" 2>/dev/null || true
      local start="origin/$base"
      git show-ref --verify --quiet "refs/remotes/$start" || start="$base"
      git worktree add "$wt_path" -b "$branch" "$start"
    fi

    # Untracked files worktrees don't inherit (env files, credential keys).
    # Patterns come from WT_COPY_PATTERNS (.wt-config), relative to the repo.
    local pat rel
    for pat in $COPY_PATTERNS; do
      for f in "$main_checkout"/$pat; do
        [ -f "$f" ] || continue
        rel="${f#"$main_checkout"/}"
        mkdir -p "$wt_path/$(dirname "$rel")"
        cp "$f" "$wt_path/$rel"
      done
    done
  fi

  local mail_dir; mail_dir="$(setup_mailbox "$session" "$wt_path")"
  local port; port="$(find_free_port)"

  # Build the layout. Panes are addressed by immutable IDs, not indexes.
  local cols=200 lines=50
  if [ -t 0 ]; then cols="$(tput cols)"; lines="$(tput lines)"; fi
  local p_driver p_shell p_dev prev pct k j i
  local agent_panes=()

  if [ "$LAYOUT" = "windows" ]; then
    # One full-screen window per agent (named), plus shell and dev windows.
    # Agent windows highlight in the status bar when output appears.
    p_driver="$(tmux new-session -d -P -F '#{pane_id}' -s "$session" -n "${AGENT_NAMES[0]}" -c "$wt_path" -x "$cols" -y "$lines")"
    agent_panes+=("$p_driver")
    for i in "${!AGENT_NAMES[@]}"; do
      [ "$i" -eq 0 ] && continue
      agent_panes+=("$(tmux new-window -P -F '#{pane_id}' -t "=$session" -n "${AGENT_NAMES[$i]}" -c "$wt_path")")
    done
    p_shell="$(tmux new-window -P -F '#{pane_id}' -t "=$session" -n shell -c "$wt_path")"
    p_dev="$(tmux new-window -P -F '#{pane_id}' -t "=$session" -n dev -c "$wt_path")"
    for i in "${!AGENT_NAMES[@]}"; do
      tmux set-option -w -t "=$session:${AGENT_NAMES[$i]}" monitor-activity on
    done
    tmux select-window -t "=$session:${AGENT_NAMES[0]}"
  else
    # Grid: driver (first roster entry) top-left; workers stacked below it.
    p_driver="$(tmux new-session -d -P -F '#{pane_id}' -s "$session" -c "$wt_path" -x "$cols" -y "$lines")"
    p_shell="$(tmux split-window -h -l '40%' -P -F '#{pane_id}' -t "$p_driver" -c "$wt_path")"
    p_dev="$(tmux split-window -v -l '50%' -P -F '#{pane_id}' -t "$p_shell" -c "$wt_path")"

    agent_panes=("$p_driver")
    k=$(( ${#AGENT_NAMES[@]} - 1 ))
    if [ "$k" -gt 0 ]; then
      case "$k" in 1) pct=40 ;; 2) pct=50 ;; *) pct=60 ;; esac
      prev="$(tmux split-window -v -l "${pct}%" -P -F '#{pane_id}' -t "$p_driver" -c "$wt_path")"
      agent_panes+=("$prev")
      j=1
      while [ "$j" -lt "$k" ]; do
        pct=$(( 100 * (k - j) / (k - j + 1) ))
        prev="$(tmux split-window -v -l "${pct}%" -P -F '#{pane_id}' -t "$prev" -c "$wt_path")"
        agent_panes+=("$prev")
        j=$((j + 1))
      done
    fi
  fi

  : > "$mail_dir/panes"
  for i in "${!AGENT_NAMES[@]}"; do
    echo "${AGENT_NAMES[$i]}=${agent_panes[$i]}" >> "$mail_dir/panes"
  done
  ensure_watcher "$session" "$mail_dir"

  local dev_cmd="echo '── dev server on http://localhost:$port ──'; "
  [ -n "$fresh" ] && dev_cmd+="$SETUP_CMD && "
  dev_cmd+="PORT=$port $DEV_CMD"
  tmux send-keys -t "$p_dev" "$dev_cmd" Enter

  # Each agent pane: identity + prod-CLI shims on PATH, logged, then launch.
  for i in "${!AGENT_NAMES[@]}"; do
    tmux pipe-pane -t "${agent_panes[$i]}" -o "cat >> '$mail_dir/logs/${AGENT_NAMES[$i]}.log'"
    tmux send-keys -t "${agent_panes[$i]}" \
      "export AGENT_MAIL_FROM=${AGENT_NAMES[$i]} PATH=\"$AGENT_ENV_DIR/shims:\$PATH\"; ${AGENT_CMDS[$i]}" Enter
  done
  tmux select-pane -t "$p_driver"

  exec_attach "$session"
}

exec_attach() {
  local session="$1"
  if [ ! -t 0 ]; then
    echo "session ready: tmux attach -t $session"
    exit 0
  fi
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$session"
  else
    exec tmux attach-session -t "=$session"
  fi
}

# --- wt init ----------------------------------------------------------------

wt_init() {
  local stack="${1:-}"
  local example="$AGENT_ENV_DIR/examples/wt-config.$stack"
  [ -n "$stack" ] && [ -f "$example" ] || die "usage: wt init <rails|node|django> (templates in $AGENT_ENV_DIR/examples/)"
  [ -e "$main_checkout/.wt-config" ] && die ".wt-config already exists in $main_checkout"
  cp "$example" "$main_checkout/.wt-config"
  git -C "$main_checkout" add -f .wt-config
  echo "staged $main_checkout/.wt-config ($stack) — commit it so it travels:"
  echo "  git -C $main_checkout commit -m 'Add .wt-config' -- .wt-config"
}

# --- Dispatch ---------------------------------------------------------------

[ $# -ge 1 ] || die "usage: wt <branch> | wt done [branch] [--force] | wt init <stack>"

case "$1" in
  done) shift; wt_done "$@" ;;
  init) shift; wt_init "$@" ;;
  *)    wt_start "$1" ;;
esac
