#!/usr/bin/env bash
#
# agent-mail — file-based mailbox for coordinating agents (claude + pi)
#
# Usage:
#   agent-mail send <to> <subject> [body ...]   Send a message (to: claude|pi|user)
#   agent-mail send <to> <subject> --body-file <path>   Body from a file (best for long messages)
#   agent-mail send <to> <subject> < file               Body from stdin works too
#   agent-mail inbox <claude|pi|user>           List unhandled messages
#   agent-mail read <file>                      Print a message
#   agent-mail done <file>                      Mark a message handled (moves to done/)
#   agent-mail spawn <agent>                    Launch a roster agent in a new tmux window
#                                               (any agent can summon any other; see roster)
#
# Approval gate (used by the credential-guard hook):
#   agent-mail request <scope> <reason ...>     Agent asks the human for a grant (message to user)
#   agent-mail grant <scope> [--minutes N]      Human grants access (credentials|prod-read: 15m, prod-write: 5m)
#   agent-mail check-grant <scope>              Exit 0 if an unexpired grant exists
#   agent-mail revoke <scope>                   Remove a grant early
#   agent-mail resume                           Clear a tripped watcher circuit breaker
#
# The mailbox is the .agent-mail symlink in the current worktree (points into
# ~/.agents-mail/<session>, created by wt). Override with AGENT_MAIL_DIR.
# (Named .agent-mail because pi owns the .agents/ directory convention.)
#
set -euo pipefail

die() { echo "agent-mail: $*" >&2; exit 1; }

find_mailbox() {
  if [ -n "${AGENT_MAIL_DIR:-}" ]; then
    echo "$AGENT_MAIL_DIR"
    return
  fi
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -e "$dir/.agent-mail" ]; then
      echo "$dir/.agent-mail"
      return
    fi
    dir="$(dirname "$dir")"
  done
  die "no .agent-mail mailbox found (run inside a wt worktree, or set AGENT_MAIL_DIR)"
}

# Fallback sender inference for two-agent setups; multi-agent panes export
# AGENT_MAIL_FROM, which always wins.
other_agent() {
  case "$1" in
    claude) echo "pi" ;;
    *)      echo "claude" ;;
  esac
}

valid_scope() {
  case "$1" in
    credentials|prod-read|prod-write) ;;
    *) die "unknown scope '$1' (expected credentials, prod-read, or prod-write)" ;;
  esac
}

cmd="${1:-}"
case "$cmd" in
  send)
    [ $# -ge 3 ] || die "usage: agent-mail send <claude|pi> <subject> [body ...]"
    to="$2"; subject="$3"; shift 3
    from="${AGENT_MAIL_FROM:-$(other_agent "$to")}"
    mailbox="$(find_mailbox)"
    inbox="$mailbox/inbox-$to"
    [ -d "$inbox" ] || die "no inbox at $inbox"

    if [ "${1:-}" = "--body-file" ]; then
      [ -n "${2:-}" ] && [ -f "$2" ] || die "--body-file: no such file: ${2:-<missing>}"
      body="$(cat "$2")"
    elif [ $# -gt 0 ]; then
      body="$*"
    elif [ ! -t 0 ]; then
      body="$(cat)"
    else
      body=""
    fi

    slug="$(echo "$subject" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/^-//;s/-$//')"
    file="$inbox/$(date +%Y%m%d-%H%M%S)-${slug:-message}.md"
    {
      echo "---"
      echo "from: $from"
      echo "to: $to"
      echo "subject: $subject"
      echo "date: $(date '+%Y-%m-%d %H:%M:%S')"
      echo "---"
      echo
      echo "$body"
    } > "$file"
    echo "$file"
    ;;

  inbox)
    [ $# -ge 2 ] || die "usage: agent-mail inbox <claude|pi>"
    mailbox="$(find_mailbox)"
    inbox="$mailbox/inbox-$2"
    [ -d "$inbox" ] || die "no inbox at $inbox"
    found=""
    for f in "$inbox"/*.md; do
      [ -f "$f" ] || continue
      found=1
      subject="$(sed -n 's/^subject: //p' "$f" | head -1)"
      echo "$f — $subject"
    done
    [ -n "$found" ] || echo "inbox empty"
    ;;

  read)
    [ $# -ge 2 ] && [ -f "$2" ] || die "usage: agent-mail read <file>"
    cat "$2"
    ;;

  done)
    [ $# -ge 2 ] && [ -f "$2" ] || die "usage: agent-mail done <file>"
    dest="$(dirname "$2")/done"
    mkdir -p "$dest"
    mv "$2" "$dest/"
    echo "moved to $dest/$(basename "$2")"
    ;;

  request)
    [ $# -ge 3 ] || die "usage: agent-mail request <scope> <reason ...>"
    scope="$2"; shift 2; valid_scope "$scope"
    from="${AGENT_MAIL_FROM:-claude}"
    AGENT_MAIL_FROM="$from" "$0" send user "[approval] $scope" \
      "Agent '$from' requests '$scope' access: $*"$'\n\n'"To approve, run: agent-mail grant $scope" >/dev/null
    echo "approval requested for '$scope' — waiting for the user to run: agent-mail grant $scope"
    ;;

  grant)
    [ $# -ge 2 ] || die "usage: agent-mail grant <scope> [--minutes N]"
    scope="$2"; shift 2; valid_scope "$scope"
    case "$scope" in prod-write) minutes=5 ;; *) minutes=15 ;; esac
    while [ $# -gt 0 ]; do
      case "$1" in
        --minutes) minutes="$2"; shift 2 ;;
        *) die "unknown option '$1'" ;;
      esac
    done
    mailbox="$(find_mailbox)"
    mkdir -p "$mailbox/grants"
    expiry=$(( $(date +%s) + minutes * 60 ))
    echo "$expiry" > "$mailbox/grants/$scope"
    echo "$(date '+%Y-%m-%d %H:%M:%S') granted $scope for ${minutes}m" >> "$mailbox/grants.log"
    echo "granted '$scope' for ${minutes} minutes"
    ;;

  check-grant)
    [ $# -ge 2 ] || die "usage: agent-mail check-grant <scope>"
    valid_scope "$2"
    mailbox="$(find_mailbox)"
    grant_file="$mailbox/grants/$2"
    if [ -f "$grant_file" ] && [ "$(cat "$grant_file")" -gt "$(date +%s)" ] 2>/dev/null; then
      exit 0
    fi
    rm -f "$grant_file"
    exit 1
    ;;

  revoke)
    [ $# -ge 2 ] || die "usage: agent-mail revoke <scope>"
    valid_scope "$2"
    mailbox="$(find_mailbox)"
    rm -f "$mailbox/grants/$2"
    echo "$(date '+%Y-%m-%d %H:%M:%S') revoked $2" >> "$mailbox/grants.log"
    echo "revoked '$2'"
    ;;

  resume)
    mailbox="$(find_mailbox)"
    rm -f "$mailbox/.paused"
    echo "watcher resumed — un-notified messages will be nudged on the next poll"
    ;;

  spawn)
    [ $# -ge 2 ] || die "usage: agent-mail spawn <agent>"
    name="$2"
    mailbox="$(find_mailbox)"
    mail_dir="$(cd "$mailbox" && pwd -P)"
    session="$(basename "$mail_dir")"
    wt_root="$(dirname "$mailbox")"
    tmux has-session -t "=$session" 2>/dev/null || die "no tmux session '$session' to spawn into"
    if grep -q "^$name=" "$mail_dir/panes" 2>/dev/null; then
      pane="$(sed -n "s/^$name=//p" "$mail_dir/panes" | head -1)"
      if tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane"; then
        echo "'$name' is already running — message it with: agent-mail send $name ..."
        exit 0
      fi
      # stale entry (window was closed) — drop it and respawn
      grep -v "^$name=" "$mail_dir/panes" > "$mail_dir/panes.tmp" && mv "$mail_dir/panes.tmp" "$mail_dir/panes"
    fi

    # Resolve the agent-env dir (this script is symlinked into ~/.local/bin)
    script_path="$0"
    while [ -L "$script_path" ]; do script_path="$(readlink "$script_path")"; done
    agent_env_dir="$(cd "$(dirname "$script_path")/.." && pwd)"
    # Roster: per-repo .wt-agents beats the global agents.conf
    main_checkout="$(dirname "$(git -C "$wt_root" rev-parse --path-format=absolute --git-common-dir)")"
    conf="$agent_env_dir/agents.conf"
    [ -f "$main_checkout/.wt-agents" ] && conf="$main_checkout/.wt-agents"
    roster_line="$(grep -E "^[[:space:]]*$name[[:space:]]*\|" "$conf" | head -1)"
    [ -n "$roster_line" ] || die "'$name' is not in the roster ($conf)"
    cmd="$(echo "$roster_line" | cut -d'|' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    notes="$(echo "$roster_line" | cut -d'|' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    command -v "${cmd%% *}" >/dev/null || die "'$name' command not installed: ${cmd%% *}"

    mkdir -p "$mail_dir/inbox-$name/done" "$mail_dir/logs"
    pane="$(tmux new-window -P -F '#{pane_id}' -d -t "=$session" -n "$name" -c "$wt_root")"
    echo "$name=$pane" >> "$mail_dir/panes"
    tmux set-option -w -t "=$session:$name" monitor-activity on 2>/dev/null || true
    tmux pipe-pane -t "$pane" -o "cat >> '$mail_dir/logs/$name.log'"
    tmux send-keys -t "$pane" "export AGENT_MAIL_FROM=$name PATH=\"$agent_env_dir/shims:\$PATH\"; $cmd" Enter
    grep -q "^$name " "$mail_dir/roster" 2>/dev/null || echo "$name — ${notes:-no notes} (spawned)" >> "$mail_dir/roster"
    echo "spawned '$name' in a new window — give it a moment to start, then: agent-mail send $name \"<subject>\" \"<body>\""
    ;;

  *)
    die "usage: agent-mail send|inbox|read|done|spawn|request|grant|check-grant|revoke|resume (see script header)"
    ;;
esac
